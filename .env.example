# Cloudflare Pages environment variables for chinarhinestone.com
# Set these in: Cloudflare Dashboard → Workers & Pages → chinarhinestone
#   → Settings → Environment variables → Production
# (Don't put real values in this file — this is just a template.)

# ── Supabase (independent project for chinarhinestone) ─────────────────
# Supabase Dashboard → Settings → API
#
# SUPABASE_SERVICE_ROLE_KEY is the ONLY variable you must add — the URL and
# the site slug have built-in defaults in functions/_lib/supabase.ts
# (DEFAULT_MAIN_SUPABASE_URL / DEFAULT_SITE_SLUG).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxx
# Optional — only needed if this site's Supabase project ever moves.
# SUPABASE_URL=https://zxobbdaqzkbfaoyahggz.supabase.co

# ── Bank accounts (read-only source) ──────────────────────────────────
# Optional. When set, bank accounts are read from this separate project
# (rows filtered by site_slug='sublimapparel') and the admin UI becomes
# read-only. When omitted, the site falls back to its own bank_accounts
# table with site_slug='chinarhinestone'.
BANK_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
BANK_SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxx

# ── Site identity ──────────────────────────────────────────────────────
# Must match the site_slug used in the database CHECK constraints.
SITE_SLUG=chinarhinestone

# ── Stripe (live mode) ─────────────────────────────────────────────────
# Stripe Dashboard → Developers → API keys
# (Replace PLACEHOLDER with your actual key — do NOT commit real values.)
STRIPE_SECRET_KEY=sk_live_PLACEHOLDER_REPLACE_WITH_YOUR_ACTUAL_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_PLACEHOLDER_REPLACE_WITH_YOUR_ACTUAL_KEY
# Stripe Dashboard → Developers → Webhooks → [your endpoint] → Reveal
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER_REPLACE_WITH_YOUR_ACTUAL_SECRET

# Frontend (NEXT_PUBLIC_ is exposed to the browser).
# Cloudflare Pages will surface this to client bundles via the same name.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_PLACEHOLDER_REPLACE_WITH_YOUR_ACTUAL_KEY

# ── Admin soft-auth tokens ─────────────────────────────────────────────
# Used to gate /api/admin/* and /api/pi/confirm-bank behind a shared
# secret sent in the X-Admin-Token / X-Confirm-Token header.
ADMIN_TOKEN=CrhAdmin2026!PI
CONFIRM_TOKEN=CrhConfirm2026!PI

# ── CORS (optional) ────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Defaults to chinarhinestone.com.
# ALLOWED_ORIGINS=https://chinarhinestone.com,http://localhost:3000
